# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# The "service_role" secret key (NOT the anon key). Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random string that protects GET /api/admin/registrations (organizer CSV export).
# Leave empty to disable the endpoint. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
